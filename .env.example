# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Public URL of the frontend (GitHub Pages in the split-host setup)
FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated allowed frontend origins for browser API calls
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx

# PayPal (sandbox by default)
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Scalapay (integration environment by default)
SCALAPAY_API_KEY=xxx
SCALAPAY_BASE_URL=https://integration.api.scalapay.com
SCALAPAY_PRODUCT=pay-in-3

# Klarna (playground by default)
KLARNA_USERNAME=xxx
KLARNA_PASSWORD=xxx
KLARNA_BASE_URL=https://api.playground.klarna.com

# Google Business Profile reviews
# Example location name: accounts/123456789/locations/987654321
GBP_ACCESS_TOKEN=xxx
GBP_LOCATION_NAME=accounts/xxx/locations/xxx
